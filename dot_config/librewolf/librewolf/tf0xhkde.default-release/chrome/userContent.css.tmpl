@-moz-document url-prefix("about:") {
  body {
    background-color: {{ .colors.background }} !important;
    color: {{ .colors.foreground }} !important;
  }

  * {
    border-radius: 0px !important;
  }

  button:hover, .button:hover {
    background-color: {{ .colors.cursor }} !important;
    color: {{ .colors.background }} !important;
  }

  * {
    --text-color:             {{ .colors.foreground }} !important;
    --color-accent-primary:   light-dark({{ .colors.cursor }}55, {{ .colors.cursor }}) !important;
    --color-accent-secondary: light-dark({{ .colors.color4 }}55, {{ .colors.color4 }}) !important;
  }

