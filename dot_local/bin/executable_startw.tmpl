#!/bin/sh
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus

exec dbus-run-session dwl -s '
    dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
    while [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; do sleep 0.1; done
    setsid swaybg --image '"{{ .chezmoi.sourceDir }}/wallpapers/{{ .theme }}/{{ .wallpaper }}"' >/dev/null 2>&1 &
    setsid wlr-randr --output DP-1 --mode 2560x1440@239.972Hz --adaptive-sync disabled >/dev/null 2>&1 &
'